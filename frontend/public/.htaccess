# Cookivo - Apache w public_html (hosting). Wgrywany przy każdym wdrożeniu razem z frontendem.
# API (/api) obsługuje aplikacja Node.js z panelu "Setup Node.js App" (Passenger).

Options -Indexes

# Plik stanu wdrożenia FTP (lista plików) - niedostępny z przeglądarki
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Zawsze HTTPS i adres bez www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # API i weryfikacja certyfikatu - bez przepisywania
  RewriteRule ^api(/|$) - [L]
  RewriteRule ^\.well-known/ - [L]

  # Istniejące pliki wprost, reszta to trasy Angulara (np. /recipes/123)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Pliki z hashem w nazwie (main-ABC123.js) można cache'ować na zawsze
  <FilesMatch "^(chunk|main|polyfills|styles)-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html i tłumaczenia zawsze świeże - po wdrożeniu widać nową wersję od razu
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Font ikon bez hasha w nazwie (scripts/icons.mjs) - zawsze sprawdzany (ETag → 304), żeby nowe ikony działały od razu
  <FilesMatch "^material-symbols-rounded\.woff2$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
