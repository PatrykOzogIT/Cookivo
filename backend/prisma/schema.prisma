generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Locale {
  pl
  en
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  /// Potwierdzenie nowego adresu (nowy adres w `payload`)
  CHANGE_EMAIL
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Nazwa wyświetlana, z zachowaną wielkością liter
  username           String    @db.VarChar(20)
  /// Małe litery, do unikalności i logowania
  usernameNormalized String    @unique @map("username_normalized") @db.VarChar(20)
  /// Zawsze zapisywany małymi literami
  email              String    @unique @db.VarChar(254)
  passwordHash       String    @map("password_hash")
  role               Role      @default(USER)
  locale             Locale    @default(pl)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  sessions    Session[]
  emailTokens EmailToken[]
  consents    Consent[]

  nutritionProfile      NutritionProfile?
  allergens             UserAllergen[]
  ingredientPreferences IngredientPreference[]
  categoryPreferences   CategoryPreference[]

  ingredientsCreated  Ingredient[] @relation("IngredientCreatedBy")
  ingredientsReviewed Ingredient[] @relation("IngredientReviewedBy")
  recipes             Recipe[]     @relation("RecipeAuthor")
  recipesHidden       Recipe[]     @relation("RecipeHiddenBy")
  photos              Photo[]

  householdMember  HouseholdMember?
  householdInvites HouseholdInvite[]

  @@map("users")
}

// =============================================================================
// Składniki i alergeny (etap 2)
// =============================================================================

/// 14 alergenów wymaganych w UE (rozporządzenie 1169/2011)
model Allergen {
  id        Int    @id @default(autoincrement())
  code      String @unique @db.VarChar(32)
  namePl    String @map("name_pl") @db.VarChar(80)
  nameEn    String @map("name_en") @db.VarChar(80)
  icon      String @db.VarChar(40)
  sortOrder Int    @default(0) @map("sort_order")

  ingredients IngredientAllergen[]
  recipes     RecipeAllergen[]
  users       UserAllergen[]

  @@map("allergens")
}

model IngredientCategory {
  id        Int    @id @default(autoincrement())
  code      String @unique @db.VarChar(32)
  namePl    String @map("name_pl") @db.VarChar(80)
  nameEn    String @map("name_en") @db.VarChar(80)
  icon      String @db.VarChar(40)
  sortOrder Int    @default(0) @map("sort_order")

  ingredients Ingredient[]
  preferences CategoryPreference[]

  @@map("ingredient_categories")
}

/// Jednostki kuchenne (łyżka, sztuka…). Gramatura jest per składnik - patrz IngredientUnit.
model Unit {
  code      String @id @db.VarChar(32)
  namePl    String @map("name_pl") @db.VarChar(40)
  nameEn    String @map("name_en") @db.VarChar(40)
  /// Objętość w ml (łyżka = 15 ml) - pozwala wyliczyć gramy z gęstości płynu
  ml        Float?
  sortOrder Int    @default(0) @map("sort_order")

  ingredients IngredientUnit[]

  @@map("units")
}

enum IngredientStatus {
  /// Dodany przez użytkownika, czeka na akceptację (widzi go tylko autor)
  PENDING
  APPROVED
  REJECTED
}

enum IngredientSource {
  USDA
  USER
}

/// Wartości odżywcze zawsze na 100 g, zgodnie z tabelą z etykiety UE.
/// null = brak danych (nie 0!).
model Ingredient {
  id         String             @id @default(uuid(7)) @db.Uuid
  namePl     String             @map("name_pl") @db.VarChar(120)
  nameEn     String?            @map("name_en") @db.VarChar(120)
  /// Znormalizowane nazwy (małe litery, bez polskich znaków) - do wyszukiwania
  searchText String             @map("search_text")
  categoryId Int                @map("category_id")
  category   IngredientCategory @relation(fields: [categoryId], references: [id])
  status     IngredientStatus   @default(PENDING)
  source     IngredientSource   @default(USER)
  /// Id w źródle (np. FDC ID z USDA)
  sourceRef  String?            @map("source_ref") @db.VarChar(40)
  /// Stały klucz składników z seeda - pozwala bezpiecznie powtarzać seed
  seedKey    String?            @unique @map("seed_key") @db.VarChar(160)

  kcal         Float
  protein      Float
  fat          Float
  saturatedFat Float? @map("saturated_fat")
  carbs        Float
  sugars       Float?
  fiber        Float?
  salt         Float?
  /// Gęstość w g/ml - tylko dla płynów
  density      Float?

  createdById     String?   @map("created_by_id") @db.Uuid
  createdBy       User?     @relation("IngredientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?     @relation("IngredientReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime? @map("reviewed_at")
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  allergens   IngredientAllergen[]
  units       IngredientUnit[]
  usedIn      RecipeIngredient[]
  preferences IngredientPreference[]

  @@index([status, categoryId])
  @@index([createdById])
  @@map("ingredients")
}

model IngredientAllergen {
  ingredientId String     @map("ingredient_id") @db.Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  allergenId   Int        @map("allergen_id")
  allergen     Allergen   @relation(fields: [allergenId], references: [id])

  @@id([ingredientId, allergenId])
  @@index([allergenId])
  @@map("ingredient_allergens")
}

model IngredientUnit {
  ingredientId String     @map("ingredient_id") @db.Uuid
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unitCode     String     @map("unit_code") @db.VarChar(32)
  unit         Unit       @relation(fields: [unitCode], references: [code])
  /// Ile gramów waży jedna jednostka tego składnika
  grams        Float

  @@id([ingredientId, unitCode])
  @@map("ingredient_units")
}

enum ConsentType {
  /// Regulamin serwisu
  TERMS
  /// Zapoznanie się z polityką prywatności
  PRIVACY_POLICY
  /// Wyraźna zgoda na przetwarzanie danych o zdrowiu (art. 9 RODO):
  /// waga, alergie, nietolerancje. Zbierana przy uzupełnianiu profilu.
  HEALTH_DATA
  /// Udostępnienie własnych alergii członkom gospodarstwa
  HOUSEHOLD_ALLERGIES
}

/// Historia zgód. Wycofanie zgody = nowy wpis z revokedAt, starych nie nadpisujemy.
model Consent {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  /// Wersja dokumentu, np. "2026-09-29"
  version   String      @db.VarChar(32)
  grantedAt DateTime    @default(now()) @map("granted_at")
  revokedAt DateTime?   @map("revoked_at")
  ip        String?     @db.VarChar(64)

  @@index([userId, type])
  @@map("consents")
}

/// Sesja = rodzina refresh tokenów. Każde odświeżenie rotuje token;
/// użycie starego tokenu oznacza kradzież i unieważnia całą sesję.
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 aktualnego refresh tokenu
  tokenHash    String    @unique @map("token_hash")
  /// SHA-256 poprzedniego tokenu, do wykrywania ponownego użycia
  previousHash String?   @unique @map("previous_hash")
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ip           String?   @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  /// Dodatkowe dane tokenu, np. nowy e-mail przy zmianie adresu
  payload   String?        @db.VarChar(254)
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("email_tokens")
}

// =============================================================================
// Przepisy (etap 3)
// =============================================================================

/// Typ posiłku (śniadanie, obiad…) - słownik, przepis może mieć kilka
model MealType {
  code      String @id @db.VarChar(32)
  namePl    String @map("name_pl") @db.VarChar(60)
  nameEn    String @map("name_en") @db.VarChar(60)
  icon      String @db.VarChar(40)
  sortOrder Int    @default(0) @map("sort_order")

  recipes RecipeMealType[]

  @@map("meal_types")
}

enum RecipeVisibility {
  PRIVATE
  /// Widoczny dla członków gospodarstwa autora
  HOUSEHOLD
  PUBLIC
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// Wartości odżywcze trzymamy jako sumy dla całego przepisu (liczone przy zapisie),
/// żeby lista mogła filtrować po kaloriach na porcję. null = brak danych w którymś składniku.
model Recipe {
  id              String           @id @default(uuid(7)) @db.Uuid
  authorId        String?          @map("author_id") @db.Uuid
  author          User?            @relation("RecipeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  title           String           @db.VarChar(150)
  description     String?          @db.VarChar(2000)
  /// Znormalizowany tytuł (bez polskich znaków) - do wyszukiwania
  searchText      String           @map("search_text")
  servings        Int
  prepMinutes     Int?             @map("prep_minutes")
  cookMinutes     Int?             @map("cook_minutes")
  difficulty      Difficulty?
  visibility      RecipeVisibility @default(PRIVATE)
  /// Może być użyty jako składnik innego przepisu (np. rosół → zupa)
  canBeIngredient Boolean          @default(false) @map("can_be_ingredient")
  /// Ukryty przez admina (np. nieodpowiednia treść) - widzi go tylko autor i admin
  hiddenAt        DateTime?        @map("hidden_at")
  hiddenById      String?          @map("hidden_by_id") @db.Uuid
  hiddenBy        User?            @relation("RecipeHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  hiddenReason    String?          @map("hidden_reason") @db.VarChar(500)

  /// Opcjonalna waga gotowej potrawy - jeśli podana, wartości na 100 g są dokładne
  /// (gotowanie odparowuje albo wchłania wodę); jeśli nie, przybliżamy sumą składników.
  cookedGrams Float? @map("cooked_grams")

  // --- Wyliczane przy zapisie ---
  /// Suma wag składników (surowych)
  totalGrams     Float  @default(0) @map("total_grams")
  kcal           Float  @default(0)
  protein        Float  @default(0)
  fat            Float  @default(0)
  saturatedFat   Float? @map("saturated_fat")
  carbs          Float  @default(0)
  sugars         Float?
  fiber          Float?
  salt           Float?
  /// Kalorie na porcję - do filtrowania i sortowania
  kcalPerServing Float  @default(0) @map("kcal_per_serving")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mealTypes   RecipeMealType[]
  ingredients RecipeIngredient[] @relation("RecipeLines")
  usedIn      RecipeIngredient[] @relation("SubRecipe")
  steps       RecipeStep[]
  photos      Photo[]
  allergens   RecipeAllergen[]

  @@index([visibility, hiddenAt])
  @@index([authorId])
  @@map("recipes")
}

model RecipeMealType {
  recipeId     String   @map("recipe_id") @db.Uuid
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  mealTypeCode String   @map("meal_type_code") @db.VarChar(32)
  mealType     MealType @relation(fields: [mealTypeCode], references: [code])

  @@id([recipeId, mealTypeCode])
  @@index([mealTypeCode])
  @@map("recipe_meal_types")
}

/// Pozycja na liście składników: składnik z bazy ALBO inny przepis (podprzepis).
model RecipeIngredient {
  id           String      @id @default(uuid(7)) @db.Uuid
  recipeId     String      @map("recipe_id") @db.Uuid
  recipe       Recipe      @relation("RecipeLines", fields: [recipeId], references: [id], onDelete: Cascade)
  position     Int
  /// Opcjonalna grupa, np. "Ciasto", "Krem"
  groupName    String?     @map("group_name") @db.VarChar(80)
  ingredientId String?     @map("ingredient_id") @db.Uuid
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  subRecipeId  String?     @map("sub_recipe_id") @db.Uuid
  subRecipe    Recipe?     @relation("SubRecipe", fields: [subRecipeId], references: [id], onDelete: Restrict)
  amount       Float
  /// 'g', 'ml', 'SERVING' (porcja podprzepisu) albo kod jednostki kuchennej
  unitCode     String      @map("unit_code") @db.VarChar(32)
  /// Wyliczona waga w gramach (do wartości odżywczych i skalowania)
  grams        Float
  /// Np. "posiekana", "do smaku"
  note         String?     @db.VarChar(120)

  @@index([recipeId])
  @@index([ingredientId])
  @@index([subRecipeId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id           String  @id @default(uuid(7)) @db.Uuid
  recipeId     String  @map("recipe_id") @db.Uuid
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  position     Int
  text         String  @db.VarChar(2000)
  /// Minutnik w trybie gotowania
  timerMinutes Int?    @map("timer_minutes")
  photoId      String? @unique @map("photo_id") @db.Uuid
  photo        Photo?  @relation("StepPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@map("recipe_steps")
}

/// Zestaw alergenów przepisu (także z podprzepisów) - przeliczany przy zapisie
model RecipeAllergen {
  recipeId   String   @map("recipe_id") @db.Uuid
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  allergenId Int      @map("allergen_id")
  allergen   Allergen @relation(fields: [allergenId], references: [id])

  @@id([recipeId, allergenId])
  @@index([allergenId])
  @@map("recipe_allergens")
}

/// Zdjęcie w WebP (kilka rozmiarów na dysku). Po wysłaniu nie jest przypięte (recipeId = null),
/// przypinamy je przy zapisie przepisu; nieprzypięte starsze niż doba są sprzątane.
model Photo {
  id        String      @id @default(uuid(7)) @db.Uuid
  /// null = autor usunął konto (zdjęcie zostaje przy zanonimizowanym przepisie publicznym)
  ownerId   String?     @map("owner_id") @db.Uuid
  owner     User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  recipeId  String?     @map("recipe_id") @db.Uuid
  recipe    Recipe?     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// Kolejność w galerii (null = zdjęcie kroku)
  position  Int?
  width     Int
  height    Int
  bytes     Int
  createdAt DateTime    @default(now()) @map("created_at")
  step      RecipeStep? @relation("StepPhoto")

  @@index([recipeId])
  @@index([ownerId, recipeId])
  @@map("photos")
}

// =============================================================================
// Profil żywieniowy i preferencje (etap 4)
// =============================================================================

enum Sex {
  FEMALE
  MALE
}

enum ActivityLevel {
  /// praca siedząca, brak ćwiczeń (×1,2)
  SEDENTARY
  /// lekka aktywność 1-3 dni w tygodniu (×1,375)
  LIGHT
  /// umiarkowana 3-5 dni (×1,55)
  MODERATE
  /// duża 6-7 dni (×1,725)
  ACTIVE
  /// bardzo duża / praca fizyczna (×1,9)
  VERY_ACTIVE
}

enum NutritionGoal {
  /// redukcja standardowa (-20%)
  CUT
  /// redukcja łagodna (-10%)
  CUT_MILD
  MAINTAIN
  /// masa łagodna (+10%)
  BULK
}

/// Dane o zdrowiu (art. 9 RODO) - zapis wymaga aktywnej zgody HEALTH_DATA,
/// wycofanie zgody usuwa profil i alergie.
model NutritionProfile {
  userId        String        @id @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex           Sex
  birthDate     DateTime      @map("birth_date") @db.Date
  heightCm      Float         @map("height_cm")
  weightKg      Float         @map("weight_kg")
  activity      ActivityLevel
  goal          NutritionGoal
  /// Ręczne nadpisania (np. zalecenia dietetyka) - null = wyliczamy automatycznie
  customKcal    Int?          @map("custom_kcal")
  customProtein Float?        @map("custom_protein")
  customFat     Float?        @map("custom_fat")
  customCarbs   Float?        @map("custom_carbs")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("nutrition_profiles")
}

enum AllergySeverity {
  ALLERGY
  INTOLERANCE
}

model UserAllergen {
  userId     String          @map("user_id") @db.Uuid
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergenId Int             @map("allergen_id")
  allergen   Allergen        @relation(fields: [allergenId], references: [id])
  severity   AllergySeverity @default(ALLERGY)

  @@id([userId, allergenId])
  @@map("user_allergens")
}

/// Brak wpisu = neutralnie
enum PreferenceLevel {
  /// nie proponuj
  NEVER
  /// czasami
  SOMETIMES
  LIKE
  LOVE
}

model IngredientPreference {
  userId       String          @map("user_id") @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId String          @map("ingredient_id") @db.Uuid
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  level        PreferenceLevel

  @@id([userId, ingredientId])
  @@map("ingredient_preferences")
}

/// Preferencja dla całej kategorii (np. ryby) - preferencja składnika ma pierwszeństwo
model CategoryPreference {
  userId     String             @map("user_id") @db.Uuid
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Int                @map("category_id")
  category   IngredientCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  level      PreferenceLevel

  @@id([userId, categoryId])
  @@map("category_preferences")
}

// --- Gospodarstwa domowe --------------------------------------------------------------

enum HouseholdRole {
  OWNER
  MEMBER
}

/// Gospodarstwo (grupa osób planujących razem). Użytkownik należy do najwyżej jednego.
model Household {
  id        String            @id @default(uuid(7)) @db.Uuid
  name      String            @db.VarChar(60)
  createdAt DateTime          @default(now()) @map("created_at")
  members   HouseholdMember[]
  invites   HouseholdInvite[]

  @@map("households")
}

model HouseholdMember {
  /// Klucz = użytkownik: jedno gospodarstwo na osobę
  userId         String        @id @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId    String        @map("household_id") @db.Uuid
  household      Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role           HouseholdRole @default(MEMBER)
  /// Zgoda na pokazanie własnych alergii domownikom i uwzględnianie ich w trybie "Dla nas"
  shareAllergies Boolean       @default(false) @map("share_allergies")
  joinedAt       DateTime      @default(now()) @map("joined_at")

  @@index([householdId])
  @@map("household_members")
}

/// Zaproszenie: jednorazowy link (hash tokenu), opcjonalnie wysłany mailem
model HouseholdInvite {
  id          String    @id @default(uuid(7)) @db.Uuid
  householdId String    @map("household_id") @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  email       String?   @db.VarChar(254)
  createdById String?   @map("created_by_id") @db.Uuid
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([householdId])
  @@map("household_invites")
}
