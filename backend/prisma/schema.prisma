generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Locale {
  pl
  en
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Nazwa wyświetlana, z zachowaną wielkością liter
  username           String    @db.VarChar(20)
  /// Małe litery, do unikalności i logowania
  usernameNormalized String    @unique @map("username_normalized") @db.VarChar(20)
  /// Zawsze zapisywany małymi literami
  email              String    @unique @db.VarChar(254)
  passwordHash       String    @map("password_hash")
  role               Role      @default(USER)
  locale             Locale    @default(pl)
  emailVerifiedAt    DateTime? @map("email_verified_at")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  sessions    Session[]
  emailTokens EmailToken[]
  consents    Consent[]

  @@map("users")
}

enum ConsentType {
  /// Regulamin serwisu
  TERMS
  /// Zapoznanie się z polityką prywatności
  PRIVACY_POLICY
  /// Wyraźna zgoda na przetwarzanie danych o zdrowiu (art. 9 RODO):
  /// waga, alergie, nietolerancje. Zbierana przy uzupełnianiu profilu.
  HEALTH_DATA
}

/// Historia zgód. Wycofanie zgody = nowy wpis z revokedAt, starych nie nadpisujemy.
model Consent {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  /// Wersja dokumentu, np. "2026-09-29"
  version   String      @db.VarChar(32)
  grantedAt DateTime    @default(now()) @map("granted_at")
  revokedAt DateTime?   @map("revoked_at")
  ip        String?     @db.VarChar(64)

  @@index([userId, type])
  @@map("consents")
}

/// Sesja = rodzina refresh tokenów. Każde odświeżenie rotuje token;
/// użycie starego tokenu oznacza kradzież i unieważnia całą sesję.
model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 aktualnego refresh tokenu
  tokenHash    String    @unique @map("token_hash")
  /// SHA-256 poprzedniego tokenu, do wykrywania ponownego użycia
  previousHash String?   @unique @map("previous_hash")
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ip           String?   @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("email_tokens")
}
