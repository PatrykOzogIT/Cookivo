NODE_ENV=development
PORT=3000

# Adres frontendu - linki w mailach i CORS
APP_URL=http://localhost:4200

DATABASE_URL=postgresql://cookivo:cookivo@localhost:5433/cookivo?schema=public
# pg = TCP (lokalnie), neon = WebSocket po 443 (produkcja na hostingu z zablokowanym portem 5432)
DB_DRIVER=pg

# Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cookivo <no-reply@cookivo.local>"

# Sprawdzanie haseł w bazie wycieków HaveIBeenPwned (k-anonymity)
HIBP_ENABLED=true

# Katalog na zdjęcia przepisów (względem katalogu backend/)
UPLOADS_DIR=uploads

# Limity żądań. Ustaw false tylko lokalnie do testów E2E (równoległe logowania z jednego IP).
THROTTLE_ENABLED=true

# Odczyt zdjęć przez AI - import przepisów i paragonów (Claude API). Bez klucza obie funkcje są ukryte
# i nic nie kosztują. Klucz z console.anthropic.com - ustaw tam też limit wydatków. Nigdy nie commituj klucza.
ANTHROPIC_API_KEY=
# Model dla obu importów
RECIPE_IMPORT_MODEL=claude-haiku-5-5
# Limity dzienne na osobę (osobno przepisy i paragony) i miesięczny wspólny dla serwisu
RECIPE_IMPORT_DAILY_LIMIT=5
RECEIPT_IMPORT_DAILY_LIMIT=5
RECIPE_IMPORT_MONTHLY_LIMIT=300
# Paragony: lista zatwierdzonych składników w poleceniu dla AI (~3 tys. tokenów, z prompt caching).
# Można wyłączyć, gdy powiązania od użytkowników wystarczą.
RECEIPT_CATALOG_HINTS=true
# Asystent: modele (wersja przepisu potrzebuje lepszego wyczucia kuchni) i limity osobne od importów
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_VARIANT_MODEL=claude-sonnet-5-5
ASSISTANT_DAILY_LIMIT=5
ASSISTANT_MONTHLY_LIMIT=500
