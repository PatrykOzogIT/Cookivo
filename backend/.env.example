NODE_ENV=development
PORT=3000

# Adres frontendu - linki w mailach i CORS
APP_URL=http://localhost:4200

DATABASE_URL=postgresql://cookivo:cookivo@localhost:5433/cookivo?schema=public

# Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cookivo <no-reply@cookivo.local>"

# Sprawdzanie haseł w bazie wycieków HaveIBeenPwned (k-anonymity)
HIBP_ENABLED=true

# Limity żądań. Ustaw false tylko lokalnie do testów E2E (równoległe logowania z jednego IP).
THROTTLE_ENABLED=true
